{
	"name": "the-ink-press",
	"version": "0.3.1",
	"private": true,
	"description": "Daily news -> summary -> image prompt -> generated image (CLI).",
	"bin": {
		"the-ink-press": "./dist/index.js"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"build": "bun build src/index.ts --target=bun --outdir=dist --minify-whitespace --minify-syntax --sourcemap=linked",
		"compile": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --sourcemap=inline --outfile=dist/the-ink-press",
		"start": "bun dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write"
	},
	"dependencies": {
		"@ai-sdk/google": "^4.0.50",
		"@ai-sdk/openai": "^4.0.46",
		"@napi-rs/image": "^1.14.0",
		"ai": "^7.0.78",
		"commander": "^15.0.0",
		"fast-xml-parser": "^5.11.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "latest",
		"typescript": "^7.0.2"
	},
	"engines": {
		"bun": ">=1.0.0"
	}
}
